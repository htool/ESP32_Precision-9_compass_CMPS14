// Copy to wifi_secrets.h in this directory (gitignored, not under src/).
// PlatformIO injects it at compile time via include_secrets.py.
// Without wifi_secrets.h the device starts its own AP named after the hostname
// (password thisisfine) so you can configure Wi-Fi from the SensESP web UI.

#pragma once

#define WIFI_SSID "YourSSID"
#define WIFI_PASSWORD "YourPassword"

// Optional failover network (tried after WIFI_SSID).
// #define WIFI_SSID_2 "BackupSSID"
// #define WIFI_PASSWORD_2 "BackupPassword"

// Password for PlatformIO `espota` uploads. Must match upload_flags --auth.
#define OTA_PASSWORD "thisisfine"
